+    let fine = format!(
+        r#"<?xml version="1.0"?>
+<!-- c --><?pi ok?><worksheet x="a &amp; b" y='1'>{rows}</worksheet>
+"#
+    );
+    let mut reader = SheetReader::for_roo(fine.as_bytes(), Mode::Document);
