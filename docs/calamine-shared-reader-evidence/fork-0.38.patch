+        ),
+        (
+            "`<` in a value",
+            format!(r#"<worksheet x="a<b">{rows}</worksheet>"#),
+        ),
+        (
+            "unknown entity in a value",
+            format!(r#"<worksheet x="&bogus;">{rows}</worksheet>"#),
+        ),
+        (
+            "unknown entity in a row's `r`",
+            r#"<worksheet><sheetData><row r="&bogus;"/></sheetData></worksheet>"#.to_string(),
+        ),
